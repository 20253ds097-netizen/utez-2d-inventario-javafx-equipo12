<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="650.0" prefWidth="900.0" spacing="15.0"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.pacientesjavafxequipo.Controllers.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <children>

        <!-- TÍTULO -->
        <Label fx:id="lbl_titulo" text="DIRECTORIO DE PACIENTES — Consultorio">
            <font><Font name="System Bold" size="20.0"/></font>
        </Label>

        <!-- BÚSQUEDA -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="Buscar:"/>
                <TextField fx:id="txt_buscar"
                           prefWidth="350.0"
                           promptText="Buscar por nombre o CURP..."/>
                <Pane HBox.hgrow="ALWAYS"/>
            </children>
        </HBox>

        <!-- MENSAJE ERROR/INFO -->
        <Label fx:id="lbl_error" textFill="#f40000">
            <font><Font name="System Bold" size="13.0"/></font>
        </Label>

        <!-- BOTONES -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Button fx:id="btn_nuevo"
                        onAction="#onOpenAddForm"
                        text="Nuevo Paciente"/>
                <Button fx:id="btn_recargar"
                        onAction="#onReload"
                        text="Recargar"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button fx:id="btn_cambiarEstatus"
                        onAction="#onCambiarEstatus"
                        text="Cambiar Estatus"/>
                <Button fx:id="btn_editar"
                        onAction="#onEditProduct"
                        text="Editar Seleccionado"/>
                <Button fx:id="btn_eliminar"
                        onAction="#onDeleteProduct"
                        text="Eliminar"/>
            </children>
        </HBox>

        <!-- TABLA -->
        <TableView fx:id="tbl_productos"
                   prefHeight="400.0"
                   prefWidth="860.0"
                   VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="col_id"
                             prefWidth="160.0"
                             text="CURP"/>
                <TableColumn fx:id="col_nombre"
                             prefWidth="200.0"
                             text="Nombre Completo"/>
                <TableColumn fx:id="col_edad"
                             prefWidth="60.0"
                             text="Edad"/>
                <TableColumn fx:id="col_telefono"
                             prefWidth="120.0"
                             text="Teléfono"/>
                <TableColumn fx:id="col_alergias"
                             prefWidth="180.0"
                             text="Alergias"/>
                <TableColumn fx:id="col_estatus"
                             prefWidth="100.0"
                             text="Estatus"/>
            </columns>
        </TableView>

        <!-- RESUMEN -->
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <padding><Insets top="5.0"/></padding>
            <children>
                <Label text="Resumen:">
                    <font><Font name="System Bold" size="13.0"/></font>
                </Label>
                <Label text="Total:">
                    <font><Font name="System Bold" size="13.0"/></font>
                </Label>
                <Label fx:id="lbl_total" text="0"/>

                <Label text="  Activos:">
                    <font><Font name="System Bold" size="13.0"/></font>
                </Label>
                <Label fx:id="lbl_activos" text="0" textFill="#007700"/>

                <Label text="  Inactivos:">
                    <font><Font name="System Bold" size="13.0"/></font>
                </Label>
                <Label fx:id="lbl_inactivos" text="0" textFill="#cc0000"/>
            </children>
        </HBox>

    </children>
</VBox>