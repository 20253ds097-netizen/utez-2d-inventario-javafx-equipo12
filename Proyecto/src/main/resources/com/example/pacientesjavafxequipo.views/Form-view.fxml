<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="480.0" prefWidth="420.0" spacing="12.0"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.pacientesjavafxequipo.Controllers.FormController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
    </padding>
    <children>

        <!-- TÍTULO -->
        <Label fx:id="lbl_titulo_form" text="Nuevo Paciente">
            <font><Font name="System Bold" size="18.0"/></font>
        </Label>

        <!-- CURP -->
        <Label text="CURP *"/>
        <TextField fx:id="txt_curp"
                   promptText="Ej. LOAM990101HDFPRS09"/>

        <!-- NOMBRE -->
        <Label text="Nombre Completo *"/>
        <TextField fx:id="txt_nombre"
                   promptText="Mínimo 5 caracteres"/>

        <!-- EDAD -->
        <Label text="Edad *"/>
        <TextField fx:id="txt_edad"
                   promptText="0 - 120 años"/>

        <!-- TELÉFONO -->
        <Label text="Teléfono *"/>
        <TextField fx:id="txt_telefono"
                   promptText="10 dígitos"/>

        <!-- ALERGIAS -->
        <Label text="Alergias"/>
        <TextField fx:id="txt_alergias"
                   promptText="Ninguna / descripción"/>

        <!-- ESTATUS -->
        <Label text="Estatus *"/>
        <ComboBox fx:id="cmb_estatus"
                  prefWidth="370.0"/>

        <!-- MENSAJE DE ERROR -->
        <Label fx:id="lbl_error_form" textFill="#f40000" wrapText="true">
            <font><Font name="System Bold" size="12.0"/></font>
        </Label>

        <!-- BOTONES -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <padding><Insets top="5.0"/></padding>
            <children>
                <Button fx:id="btn_cancelar"
                        onAction="#onCancelar"
                        text="Cancelar"/>
                <Button fx:id="btn_guardar"
                        onAction="#onGuardar"
                        text="Guardar"
                        defaultButton="true"/>
            </children>
        </HBox>

    </children>
</VBox>
