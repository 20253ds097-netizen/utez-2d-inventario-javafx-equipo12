<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.pacientesjavafxequipo12.Controllers.FormController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <children>
        <Label fx:id="lbl_titulo_form" text="Nuevo Paciente" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>

        <Label text="CURP *"/>
        <TextField fx:id="txt_curp" />

        <Label text="Nombre Completo *"/>
        <TextField fx:id="txt_nombre" />

        <Label text="Edad *"/>
        <TextField fx:id="txt_edad" />

        <Label text="Teléfono *"/>
        <TextField fx:id="txt_telefono" />

        <Label text="Alergias"/>
        <TextField fx:id="txt_alergias" />

        <Label text="Estatus *"/>
        <ComboBox fx:id="cmb_estatus" maxWidth="Infinity" />

        <Label fx:id="lbl_error_form" textFill="RED" wrapText="true" />

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="btn_cancelar" text="Cancelar" onAction="#onCancelar"/>
                <Button fx:id="btn_guardar" text="Guardar" onAction="#onGuardar" defaultButton="true"/>
            </children>
        </HBox>
    </children>
</VBox>