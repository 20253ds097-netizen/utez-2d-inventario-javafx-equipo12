                        text="Eliminar"/>
            </children>
        </HBox>

        <!-- TABLA -->
        <TableView fx:id="tbl_productos"
                   prefHeight="400.0"
                   prefWidth="860.0"
                   VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="col_id"
                             prefWidth="160.0"
                             text="CURP"/>
                <TableColumn fx:id="col_nombre"
                             prefWidth="200.0"
                             text="Nombre Completo"/>
                <TableColumn fx:id="col_edad"
                             prefWidth="60.0"
                             text="Edad"/>
                <TableColumn fx:id="col_telefono"
                             prefWidth="120.0"
                             text="Teléfono"/>
                <TableColumn fx:id="col_alergias"
                             prefWidth="180.0"
                             text="Alergias"/>
                <TableColumn fx:id="col_estatus"
                             prefWidth="100.0"
                             text="Estatus"/>
            </columns>
        </TableView>

