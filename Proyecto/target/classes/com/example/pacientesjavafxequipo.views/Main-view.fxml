<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.pacientesjavafxequipo.Controllers.MainController"
      spacing="10"
      style="-fx-padding: 16;">

    <HBox spacing="10">
        <Button text="Nuevo paciente" onAction="#abrirFormulario"/>
        <Button text="Cambiar estatus" onAction="#cambiarEstatus"/>
        <Button text="Refrescar"       onAction="#cargarPacientes"/>
        <Label fx:id="lblResumen" text="Activos: 0 | Inactivos: 0"
               style="-fx-padding: 4 0 0 10;"/>
    </HBox>

    <TableView fx:id="tablaPacientes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCurp"     text="CURP"      prefWidth="180"/>
            <TableColumn fx:id="colNombre"   text="Nombre"    prefWidth="160"/>
            <TableColumn fx:id="colEdad"     text="Edad"      prefWidth="60"/>
            <TableColumn fx:id="colTelefono" text="Teléfono"  prefWidth="110"/>
            <TableColumn fx:id="colAlergias" text="Alergias"  prefWidth="130"/>
            <TableColumn fx:id="colEstatus"  text="Estatus"   prefWidth="90"/>
        </columns>
    </TableView>

</VBox>